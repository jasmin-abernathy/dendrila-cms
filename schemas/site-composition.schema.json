{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MMW CMS Site Composition",
  "type": "object",
  "required": [
    "schema_version",
    "functional_kit",
    "design_style"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "functional_kit": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "design_style": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "enabled_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "brand_overrides": {
      "type": "object",
      "properties": {
        "logo_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "additionalProperties": false
    },
    "style_overrides": {
      "type": "object",
      "required": [],
      "properties": {
        "layout": {
          "type": "object",
          "required": [],
          "properties": {
            "content_width": {
              "enum": [
                "narrow",
                "medium",
                "wide",
                "full"
              ]
            },
            "section_spacing": {
              "enum": [
                "compact",
                "balanced",
                "airy"
              ]
            },
            "hero": {
              "enum": [
                "minimal",
                "text_first",
                "media_first",
                "split"
              ]
            },
            "text_column": {
              "enum": [
                "narrow",
                "medium",
                "wide"
              ]
            },
            "alignment": {
              "enum": [
                "left",
                "center",
                "mixed"
              ]
            }
          },
          "additionalProperties": false
        },
        "typography": {
          "type": "object",
          "required": [],
          "properties": {
            "heading_style": {
              "enum": [
                "neutral",
                "humanist",
                "editorial",
                "display"
              ]
            },
            "body_style": {
              "enum": [
                "neutral",
                "humanist",
                "editorial"
              ]
            },
            "scale": {
              "enum": [
                "restrained",
                "balanced",
                "expressive"
              ]
            }
          },
          "additionalProperties": false
        },
        "media": {
          "type": "object",
          "required": [],
          "properties": {
            "prominence": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "crop": {
              "enum": [
                "natural",
                "cover",
                "mixed"
              ]
            },
            "gallery": {
              "enum": [
                "grid",
                "masonry",
                "filmstrip",
                "editorial"
              ]
            },
            "full_bleed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "illustration": {
          "type": "object",
          "required": [],
          "properties": {
            "frequency": {
              "enum": [
                "none",
                "occasional",
                "regular"
              ]
            },
            "style": {
              "enum": [
                "none",
                "line",
                "flat",
                "geometric",
                "organic"
              ]
            }
          },
          "additionalProperties": false
        },
        "surfaces": {
          "type": "object",
          "required": [],
          "properties": {
            "radius": {
              "enum": [
                "none",
                "small",
                "medium",
                "large"
              ]
            },
            "borders": {
              "enum": [
                "none",
                "subtle",
                "present"
              ]
            },
            "shadows": {
              "enum": [
                "none",
                "subtle"
              ]
            }
          },
          "additionalProperties": false
        },
        "accent": {
          "type": "object",
          "required": [],
          "properties": {
            "usage": {
              "enum": [
                "restrained",
                "balanced",
                "strong"
              ]
            },
            "backgrounds": {
              "enum": [
                "neutral",
                "soft_sections",
                "alternating"
              ]
            }
          },
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "required": [],
          "properties": {
            "level": {
              "enum": [
                "none",
                "subtle",
                "expressive"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Partial closed tokens; nested groups accept only declared token keys."
    }
  },
  "additionalProperties": false
}
