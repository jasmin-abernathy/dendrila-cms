{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MMW CMS Content Type",
  "type": "object",
  "required": [
    "id",
    "label",
    "fields"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "collection": {
      "type": "boolean"
    },
    "workflow": {
      "enum": [
        "editorial",
        "direct"
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "enum": [
              "text",
              "multiline",
              "rich_text",
              "boolean",
              "number",
              "url",
              "email",
              "choice",
              "media",
              "relation",
              "blocks"
            ]
          },
          "label": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "multiple": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
