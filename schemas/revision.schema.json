{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MMW CMS Revision",
  "type": "object",
  "required": [
    "revision_id",
    "site_id",
    "entity_id",
    "entity_type",
    "version",
    "author_id",
    "created_at",
    "change_summary",
    "source",
    "snapshot"
  ],
  "properties": {
    "revision_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "author_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "change_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "enum": [
        "web",
        "mmw",
        "import",
        "system"
      ]
    },
    "snapshot": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
