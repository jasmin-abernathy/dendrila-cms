{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MMW CMS Design Style",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "label",
    "description",
    "keywords",
    "tokens",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "tokens": {
      "type": "object",
      "required": [
        "layout",
        "typography",
        "media",
        "illustration",
        "surfaces",
        "accent",
        "motion"
      ],
      "properties": {
        "layout": {
          "type": "object",
          "required": [
            "content_width",
            "section_spacing",
            "hero",
            "text_column",
            "alignment"
          ],
          "properties": {
            "content_width": {
              "enum": [
                "narrow",
                "medium",
                "wide",
                "full"
              ]
            },
            "section_spacing": {
              "enum": [
                "compact",
                "balanced",
                "airy"
              ]
            },
            "hero": {
              "enum": [
                "minimal",
                "text_first",
                "media_first",
                "split"
              ]
            },
            "text_column": {
              "enum": [
                "narrow",
                "medium",
                "wide"
              ]
            },
            "alignment": {
              "enum": [
                "left",
                "center",
                "mixed"
              ]
            }
          },
          "additionalProperties": false
        },
        "typography": {
          "type": "object",
          "required": [
            "heading_style",
            "body_style",
            "scale"
          ],
          "properties": {
            "heading_style": {
              "enum": [
                "neutral",
                "humanist",
                "editorial",
                "display"
              ]
            },
            "body_style": {
              "enum": [
                "neutral",
                "humanist",
                "editorial"
              ]
            },
            "scale": {
              "enum": [
                "restrained",
                "balanced",
                "expressive"
              ]
            }
          },
          "additionalProperties": false
        },
        "media": {
          "type": "object",
          "required": [
            "prominence",
            "crop",
            "gallery",
            "full_bleed"
          ],
          "properties": {
            "prominence": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "crop": {
              "enum": [
                "natural",
                "cover",
                "mixed"
              ]
            },
            "gallery": {
              "enum": [
                "grid",
                "masonry",
                "filmstrip",
                "editorial"
              ]
            },
            "full_bleed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "illustration": {
          "type": "object",
          "required": [
            "frequency",
            "style"
          ],
          "properties": {
            "frequency": {
              "enum": [
                "none",
                "occasional",
                "regular"
              ]
            },
            "style": {
              "enum": [
                "none",
                "line",
                "flat",
                "geometric",
                "organic"
              ]
            }
          },
          "additionalProperties": false
        },
        "surfaces": {
          "type": "object",
          "required": [
            "radius",
            "borders",
            "shadows"
          ],
          "properties": {
            "radius": {
              "enum": [
                "none",
                "small",
                "medium",
                "large"
              ]
            },
            "borders": {
              "enum": [
                "none",
                "subtle",
                "present"
              ]
            },
            "shadows": {
              "enum": [
                "none",
                "subtle"
              ]
            }
          },
          "additionalProperties": false
        },
        "accent": {
          "type": "object",
          "required": [
            "usage",
            "backgrounds"
          ],
          "properties": {
            "usage": {
              "enum": [
                "restrained",
                "balanced",
                "strong"
              ]
            },
            "backgrounds": {
              "enum": [
                "neutral",
                "soft_sections",
                "alternating"
              ]
            }
          },
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "enum": [
                "none",
                "subtle",
                "expressive"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "required": [
        "contrast_target",
        "focus_visible",
        "reduced_motion",
        "autoplay_media"
      ],
      "properties": {
        "contrast_target": {
          "enum": [
            "AA",
            "AAA"
          ]
        },
        "focus_visible": {
          "const": true
        },
        "reduced_motion": {
          "const": true
        },
        "autoplay_media": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
