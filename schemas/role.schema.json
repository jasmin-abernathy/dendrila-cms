{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MMW CMS Role",
  "type": "object",
  "required": [
    "id",
    "label",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "label": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      }
    }
  },
  "additionalProperties": false
}
