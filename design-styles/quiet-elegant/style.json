{
  "schema_version": 1,
  "id": "quiet-elegant",
  "label": "Sobre et élégant",
  "description": "Composition chaleureuse et aérée, portrait ou image organique, typographie raffinée et sections douces, dans l’esprit d’un site de bien-être.",
  "keywords": [
    "sobre",
    "élégant",
    "aéré",
    "typographie"
  ],
  "tokens": {
    "layout": {
      "content_width": "medium",
      "section_spacing": "airy",
      "hero": "split",
      "text_column": "narrow",
      "alignment": "left"
    },
    "typography": {
      "heading_style": "editorial",
      "body_style": "neutral",
      "scale": "balanced"
    },
    "media": {
      "prominence": "medium",
      "crop": "mixed",
      "gallery": "editorial",
      "full_bleed": false
    },
    "illustration": {
      "frequency": "occasional",
      "style": "organic"
    },
    "surfaces": {
      "radius": "none",
      "borders": "subtle",
      "shadows": "none"
    },
    "accent": {
      "usage": "restrained",
      "backgrounds": "neutral"
    },
    "motion": {
      "level": "none"
    }
  },
  "constraints": {
    "contrast_target": "AA",
    "focus_visible": true,
    "reduced_motion": true,
    "autoplay_media": false
  }
}
