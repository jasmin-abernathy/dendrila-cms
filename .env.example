APP_ENV=local
APP_DEBUG=false
APP_BASE_URL=https://cms.example.test
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=mmw_cms;charset=utf8mb4
DB_USERNAME=mmw_cms
DB_PASSWORD=change-me
MEDIA_STORAGE_PATH=/home/account/private/mmw-cms-media
DENDRILA_DESIGN_KITS_CATALOG=/home/account/repositories/dendrila-design-kits/catalog.json


# Native media library (enable only after provisioning a private directory outside every web root).
# MEDIA_PRIVATE_ROOT=/home/account/private/dendrila-media
# MEDIA_PUBLIC_ENDPOINT=https://example.test/media.php
# MEDIA_MAX_BYTES=10000000
# MEDIA_MAX_DIMENSION=6000
# MEDIA_MAX_PIXELS=12000000

# Optional bridge for a pilot that already owns the historical MMW pairing/device tables.
# Leave DENDRILA_IDENTITY_PROVIDER unset to keep authentication routes fail-closed.
# DENDRILA_IDENTITY_PROVIDER=legacy_mmw_pairing
# DENDRILA_IDENTITY_SITE_ID=pilot-site
# DENDRILA_IDENTITY_HMAC_SECRET=use-the-existing-site-hmac-secret-outside-git
# DENDRILA_IDENTITY_ROLE_MAP={"owner":"owner"}

